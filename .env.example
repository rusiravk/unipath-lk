# Copy to .env (ignored by Git) for local runs, or set these in JacHammer Settings for the hosted app.
# Never commit real keys and never put them in client code.

# Optional: enables the live AI planner. Without a key the app runs the deterministic
# decision table and reports planner_mode = rules_fallback (fallback_reason = no_api_key).
OPENAI_API_KEY=
# Optional model override (default is set in jac.toml).
LLM_MODEL=gpt-4o-mini

# Set to 1 to force the rules fallback even when a key is present (used for the no-key check).
UNIPATH_DISABLE_AI=
